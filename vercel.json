{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/@img/**,node_modules/sharp/**,node_modules/@napi-rs/**,node_modules/pdfjs-dist/**,server/process-worker.js,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/maintenance", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" },
    { "source": "/workspace/:path*", "destination": "/index.html" },
    { "source": "/workspace", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/maintenance", "schedule": "0 0 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; frame-src 'self' blob: https://api.razorpay.com; connect-src 'self' https://api.razorpay.com http://127.0.0.1:17631; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
